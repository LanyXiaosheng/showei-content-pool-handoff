# 复制为 .env.docker 后填写。切勿把真实密钥提交到 Git。
POSTGRES_DB=shiwei
POSTGRES_USER=shiwei
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=4100
PUBLIC_ORIGIN=http://localhost:4100

# openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-secret

# 首次 seed 时使用；seed 后建议登录后台修改密码。
ADMIN_EMAIL=admin@shiwei.local
SEED_PASSWORD=replace-with-a-strong-initial-password

# 生产环境建议 false。true 会开放登录页一键演示入口。
DEMO_MODE=false
SESSION_TTL_DAYS=7
WORKER_POLL_MS=800
LOG_LEVEL=info

# 可选：部署新版小生清流解析服务后填写其 HTTPS /api/v1 地址
DIANPING_PARSER_API_URL=
