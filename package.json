{
  "name": "shiwei-content-pool",
  "version": "1.0.0",
  "private": true,
  "description": "\u62fe\u5473 \u00b7 \u63a2\u5e97\u7d20\u6750\u53d8\u4f53\u751f\u6210\u4e0e\u72ec\u5360\u9886\u53d6\u5185\u5bb9\u6c60",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c green,magenta,cyan \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && tsc -p tsconfig.server.json && cp server/schema.sql dist/server/schema.sql",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker.js",
    "start:all": "concurrently -k -n api,worker -c green,magenta \"pnpm start\" \"pnpm start:worker\"",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test:dianping": "tsx --test server/services/dianping.test.ts",
    "start:migrate": "node dist/server/cli/migrate.js",
    "start:seed": "node dist/server/cli/seed.js",
    "package:handoff": "bash scripts/package-handoff.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@tanstack/react-query": "^5.83.0",
    "archiver": "^7.0.1",
    "argon2": "^0.43.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "adm-zip": "^0.6.1",
    "concurrently": "^9.2.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
