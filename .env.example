# 复制为 .env。生产环境必须替换加密密钥与所有密码。
NODE_ENV=development
PORT=4100
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://shiwei:shiwei@127.0.0.1:5432/shiwei_content_pool
# 32 字节随机数的 base64：openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-secret
DATA_DIR=./data
WEB_DIST=./dist/web
SESSION_TTL_DAYS=7
DEMO_MODE=true
ADMIN_EMAIL=admin@shiwei.local
DEMO_PASSWORD=change-me-before-production
WORKER_POLL_MS=800
# 大众点评解析服务（服务端调用；Cookie 仅配置在解析服务，不放在拾味前端）
DIANPING_PARSER_API_URL=http://127.0.0.1:8051/api/v1
